    {
      "id": 7,
      "type": "timeseries",
      "title": "Temperatura, previsão e freio",
      "description": "A temperatura de agora, a prevista para daqui a 10 s e a intensidade do freio (0 a 100 %). A curva começa a frear em 80 °C e chega ao máximo em 92 °C, de agora ou prevista.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 12,
        "h": 9
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "termostato_temperatura_celsius",
          "legendFormat": "agora",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "termostato_temperatura_prevista_celsius",
          "legendFormat": "prevista",
          "refId": "B"
