          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "termostato_freio_intensidade * 100",
          "legendFormat": "freio (%)",
          "refId": "C"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "celsius",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 10,
            "showPoints": "never"
